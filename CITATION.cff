    given-names: Karthikeyan
    orcid: "https://orcid.org/0009-0008-3539-6048"
license: Apache-2.0
repository-code: "https://github.com/sadayamuthu/taintline"
url: "https://openastra.org"
keywords:
  - AI agents
  - prompt injection
  - information flow control
  - taint tracking
  - MCP
